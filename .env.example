# Copy this file to .env and fill in your values. Never commit .env.
# Neon connection string (Neon console -> your project -> Connect)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full
# Shop timezone used for due dates and interest
APP_TIMEZONE=Asia/Colombo
# Any long random text; Vercel Cron uses it to call /api/cron
CRON_SECRET=change-me
