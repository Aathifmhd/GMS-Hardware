# Copy this file to .env and fill in your values. Never commit .env.
# Supabase connection string: Supabase dashboard -> Connect -> "Transaction pooler" (port 6543), with your
# database password in place of [YOUR-PASSWORD]. Any other Postgres connection string works too.
DATABASE_URL=postgresql://postgres.PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Optional: Supabase's CA certificate (Database settings -> SSL Configuration -> Download certificate) on one
# line, with \n for each line break. With it the database server is verified; without it the connection is
# still encrypted.
# DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----\nMIID...\n-----END CERTIFICATE-----
# Shop timezone used for due dates and interest
APP_TIMEZONE=Asia/Colombo
# Any long random text; Vercel Cron uses it to call /api/cron
CRON_SECRET=change-me
# Only for the one-time `npm run copy-db`: the old database to copy from (e.g. Neon)
# SOURCE_DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full
